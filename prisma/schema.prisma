// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Source {
  id                String     @id
  name              String
  url               String     @unique
  enabled           Boolean    @default(true)
  language          String?
  country           String?
  defaultCategoryId String
  lastFetchedAt     DateTime?
  lastError         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  defaultCategory   Category   @relation("DefaultCategorySources", fields: [defaultCategoryId], references: [id])
  articles          NewsItem[]
}

model Category {
  id          String   @id
  label       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources     Source[] @relation("DefaultCategorySources")
  articles    NewsItemCategory[]
}

model NewsItem {
  id             String   @id @default(cuid())
  guid           String?  // RSSのguid
  title          String   // 記事のタイトル
  link           String   @unique // 記事のURL (重複保存を防ぐためuniqueが推奨)
  pubDate        DateTime? // 公開日時 (isoDateをDate型に変換して保存)
  creator        String?  // 作成者/著者
  summary        String?  // 概要
  content        String?  // コンテンツ本文
  contentSnippet String?  // コンテンツの抜粋
  rawCategories  String[] // 元のRSSカテゴリ一覧

  // Enclosure (画像や音声などのメディアファイル情報)
  enclosureUrl    String?
  enclosureLength Int?
  enclosureType   String?

  imageUrl            String?
  imageFetchStatus    ImageFetchStatus @default(QUEUED)
  imageFetchStartedAt DateTime?
  imageFetchMessageId String?

  sourceId        String
  source          Source   @relation(fields: [sourceId], references: [id])

  categories      NewsItemCategory[]

  createdJobExecutionId String?
  jobExecution          JobExecution? @relation("JobExecutionNewsItems", fields: [createdJobExecutionId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now()) // DBへの保存日時
  updatedAt       DateTime @updatedAt      // レコード更新日時

  @@index([createdJobExecutionId])
}

enum ImageFetchStatus {
  QUEUED
  PROCESSING
  SUCCESS
  NOT_FOUND
  FAILED
}

enum JobType {
  RSS_SYNC
  SWEEPER_ONLY
  MANUAL_SYNC
}

enum JobStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  TIMEOUT
}

enum FeedSyncStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

enum JobEventLevel {
  INFO
  WARN
  ERROR
}

model NewsItemCategory {
  newsItemId String
  categoryId String
  method     String   @default("source-default")
  confidence Float?
  createdAt  DateTime @default(now())

  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([newsItemId, categoryId])
  @@index([categoryId])
}

model JobExecution {
  id                    String             @id @default(cuid())
  jobType               JobType
  status                JobStatus          @default(RUNNING)
  triggerSource         String?
  startedAt             DateTime           @default(now())
  finishedAt            DateTime?
  durationMs            Int?
  feedTotalCount        Int                @default(0)
  feedSuccessCount      Int                @default(0)
  feedFailureCount      Int                @default(0)
  itemsFound            Int                @default(0)
  itemsCreated          Int                @default(0)
  itemsSkipped          Int                @default(0)
  itemsFailed           Int                @default(0)
  queuedCount           Int                @default(0)
  queueFailureCount     Int                @default(0)
  recoveredQueuedCount   Int                @default(0)
  errorCode             String?
  errorMessage           String?
  errorStack            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  feedSyncExecutions    FeedSyncExecution[]
  jobEvents             JobEvent[]
  newsItems             NewsItem[]         @relation("JobExecutionNewsItems")

  @@index([startedAt])
  @@index([status])
}

model FeedSyncExecution {
  id              String          @id @default(cuid())
  jobExecutionId  String
  sourceId        String
  sourceName      String
  sourceUrl       String
  status          FeedSyncStatus
  httpStatus      Int?
  durationMs      Int?
  itemsFound      Int             @default(0)
  itemsCreated    Int             @default(0)
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime        @default(now())

  jobExecution    JobExecution    @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)

  @@index([jobExecutionId])
  @@index([status])
}

model JobEvent {
  id              String        @id @default(cuid())
  jobExecutionId  String
  eventType       String
  level           JobEventLevel
  message         String
  metadata        Json?
  createdAt       DateTime      @default(now())

  jobExecution    JobExecution  @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)

  @@index([jobExecutionId])
  @@index([level])
  @@index([createdAt])
}

