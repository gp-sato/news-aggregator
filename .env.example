# ==============================================================================
# データベース接続設定 (Supabase & Prisma v7)
# ==============================================================================

# Supabase の接続プーリング（Transaction Mode）用URL。アプリ内のクエリ処理に使用されます。
# [取得元]: Supabase Dashboard > Connect > ORM > Prisma
# [注意]: [YOUR-PASSWORD] は控えておいたデータベースパスワードに置き換えてください。
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# データベースへの直接接続（Session Mode）用URL。Prismaマイグレーション（migrate dev）時に使用されます。
# [取得元]: Supabase Dashboard > Connect > ORM > Prisma (DIRECT_URL)
# [注意]: [YOUR-PASSWORD] は控えておいたデータベースパスワードに置き換えてください。
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"


# ==============================================================================
# アプリケーション動作設定
# ==============================================================================

# 動作環境 (development / production)
NODE_ENV="development"


# ==============================================================================
# セキュリティ・外部連携設定 (Vercel Cron)
# ==============================================================================

# Vercel Cronジョブの実行を保護するためのセキュリティキー。
# 本番環境（NODE_ENV="production"）では必須です。
# 任意のランダムな文字列（例: `openssl rand -base64 32` などで生成した文字列）を設定してください。
# ローカル開発環境で動作テストする際は、空のままで問題ありません。
CRON_SECRET="local-development-secret-key-12345"