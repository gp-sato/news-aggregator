# ==============================================================================
# ローカル開発環境データベース接続設定 (Supabase Local & Prisma v7)
# ==============================================================================

# ローカル Supabase のコンテナ接続用 URL (Prisma接続用)
# ※ Supabase Local が起動している際に、以下のアドレスで接続可能です。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# データベースへの直接接続用URL
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"


# ==============================================================================
# アプリケーション動作設定
# ==============================================================================

# 動作環境 (development / production)
NODE_ENV="development"


# ==============================================================================
# セキュリティ・外部連携設定 (Vercel Cron)
# ==============================================================================

# ローカル開発環境での動作テスト用のシークレットキー
# 任意のランダムな文字列（例: `openssl rand -base64 32` などで生成した文字列）を設定してください。
CRON_SECRET="local-development-secret-key-12345"


# ==============================================================================
# ニュースクリーンアップ設定
# ==============================================================================

# ニュース記事の保持期間（日数）。この日数より古い記事は自動削除されます。
# デフォルト: 30
NEWS_RETENTION_DAYS=30

# クリーンアップのバッチサイズ（1回の削除で処理する最大件数）。
# デフォルト: 500
NEWS_CLEANUP_BATCH_SIZE=500

# クリーンアップの最大削除件数（1回のcron実行で削除する総件数の上限）。
# デフォルト: 5000
NEWS_CLEANUP_MAX_ITEMS=5000

# クリーンアップの実行時間制限（ミリ秒）。この時間を超えると処理を中断します。
# デフォルト: 45000 (45秒)
NEWS_CLEANUP_DEADLINE_MS=45000
