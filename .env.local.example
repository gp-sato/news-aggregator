# ==============================================================================
# ローカル開発環境データベース接続設定 (Supabase Local & Prisma v7)
# ==============================================================================

# ローカル Supabase のコンテナ接続用 URL (Prisma接続用)
# ※ Supabase Local が起動している際に、以下のアドレスで接続可能です。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# データベースへの直接接続用URL
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"


# ==============================================================================
# アプリケーション動作設定
# ==============================================================================

# 動作環境 (development / production)
NODE_ENV="development"


# ==============================================================================
# セキュリティ・外部連携設定 (Vercel Cron)
# ==============================================================================

# ローカル開発環境での動作テスト用のシークレットキー
# 任意のランダムな文字列（例: `openssl rand -base64 32` などで生成した文字列）を設定してください。
CRON_SECRET="local-development-secret-key-12345"
